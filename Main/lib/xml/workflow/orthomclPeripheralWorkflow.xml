<workflowGraph name="">
  <param name="parentDataDir"/>
  <param name="residualGroupIdPrefix"/>
  <param name="oldReleasesGroupFilesDir"/>
  <param name="relativeDownloadSiteDir"/>
  <param name="relativeWebServicesDir"/>
  <param name="coreProteome"/>
  <param name="coreResultsDir"/>

  <constant name="projectName">OrthoMCL</constant>
  <constant name="getPeripheralProteinsDir">$$projectName$$/peripheralProteins</constant>
  <constant name="residualFastaFilesDir">$$getPeripheralProteinsDir$$/residualFastaFiles</constant>
  <constant name="makeResidualGroupsDir">$$projectName$$/makeResidualGroups</constant>
  <constant name="residualGroupsDir">$$projectName$$/residualGroups</constant>
  <constant name="peripheralDir">$$projectName$$/peripheralGroups</constant>
  <!-- Same computation as OrthoMCLCore.xml's own coreProteinsDir constant, since both this
       graph and OrthoMCLCore.xml are fed the same parentDataDir ($$projectName$$, from
       orthomclGenomics.xml), so this resolves to the identical path as the "coreChanged"
       marker file that CheckOrthomclBuildVersion.pm (over in OrthoMCLCore.xml) writes. -->
  <constant name="coreProteinsDir">$$parentDataDir$$/coreProteins</constant>

  <step name="makePeripheralDir" stepClass="ReFlow::StepClasses::MakeDataDir">
      <paramValue name="dataDir">$$peripheralDir$$</paramValue>
  </step>

  <step name="makePeripheralAnalysisDir" stepClass="ReFlow::StepClasses::MakeDataDir">
     <paramValue name="dataDir">$$peripheralDir$$/analysisDir</paramValue>
     <depends name="makePeripheralDir"/>
  </step>

  <step name="makePeripheralEntryResultsDir" stepClass="ReFlow::StepClasses::MakeDataDir">
    <paramValue name="dataDir">$$peripheralDir$$/analysisDir/peripheralEntryResults/</paramValue>
    <depends name="makePeripheralAnalysisDir"/>
  </step>

  <step name="makeResidualEntryResultsDir" stepClass="ReFlow::StepClasses::MakeDataDir">
    <paramValue name="dataDir">$$peripheralDir$$/analysisDir/residualEntryResults/</paramValue>
    <depends name="makePeripheralEntryResultsDir"/>
  </step>

  <step name="makePostResidualEntryResultsDir" stepClass="ReFlow::StepClasses::MakeDataDir">
    <paramValue name="dataDir">$$peripheralDir$$/analysisDir/postResidualEntryResults/</paramValue>
    <depends name="makeResidualEntryResultsDir"/>
  </step>

  <step name="makePostProcessingEntryResultsDir" stepClass="ReFlow::StepClasses::MakeDataDir">
    <paramValue name="dataDir">$$peripheralDir$$/analysisDir/postProcessingEntryResults/</paramValue>
    <depends name="makePostResidualEntryResultsDir"/>
  </step>

  <step name="checkBuildVersionCreatePeripheralOutdatedOrganisms" stepClass="ApiCommonWorkflow::Main::WorkflowSteps::CreatePeripheralOutdatedOrganisms">
    <paramValue name="checkSum">$$getPeripheralProteinsDir$$/fastas/checkSum.tsv</paramValue>
    <paramValue name="outdatedOrganisms">$$peripheralDir$$/outdated.txt</paramValue>
    <paramValue name="skipIfFile">$$getPeripheralProteinsDir$$/doNotDoAnalysis</paramValue>
    <depends name="makePostProcessingEntryResultsDir"/>
  </step>

  <step name="CopyAndUncompressPeripheralCacheDir" stepClass="ApiCommonWorkflow::Main::WorkflowSteps::CopyAndUncompressPeripheralCacheDir">
    <paramValue name="outputDir">$$peripheralDir$$</paramValue>
    <depends name="checkBuildVersionCreatePeripheralOutdatedOrganisms"/>
  </step>

  <step name="RetrievePreviousGroupsMapping" stepClass="ApiCommonWorkflow::Main::WorkflowSteps::RetrievePreviousGroupsMapping">
    <paramValue name="outputDir">$$peripheralDir$$</paramValue>
    <depends name="CopyAndUncompressPeripheralCacheDir"/>
  </step>

  <step name="copyCoreGroups" stepClass="ApiCommonWorkflow::Main::WorkflowSteps::CopyDataDirFile">
     <paramValue name="fromFile">$$coreResultsDir$$/reformattedGroups.txt</paramValue>
     <paramValue name="toFile">$$peripheralDir$$/reformattedGroups.txt</paramValue>
     <depends name="RetrievePreviousGroupsMapping"/>
  </step>

  <step name="copyCoreDiamondResults" stepClass="ApiCommonWorkflow::Main::WorkflowSteps::CopyDataDir">
     <paramValue name="fromDir">$$coreResultsDir$$/groupDiamondResults</paramValue>
     <paramValue name="toDir">$$peripheralDir$$/groupDiamondResults</paramValue>
     <depends name="copyCoreGroups"/>
  </step>

  <step name="copyCoreSequenceIds" stepClass="ApiCommonWorkflow::Main::WorkflowSteps::CopyDataDirFile">
     <paramValue name="fromFile">$$coreResultsDir$$/SequenceIDs.txt</paramValue>
     <paramValue name="toFile">$$peripheralDir$$/SequenceIDs.txt</paramValue>
     <depends name="copyCoreDiamondResults"/>
  </step>

  <step name="copyCoreProteomes" stepClass="ApiCommonWorkflow::Main::WorkflowSteps::CopyDataDirFile">
     <paramValue name="fromFile">$$coreProteome$$</paramValue>
     <paramValue name="toFile">$$peripheralDir$$/coreFastas.tar.gz</paramValue>
     <depends name="copyCoreSequenceIds"/>
  </step>

  <step name="copyPeripheralProteomes" stepClass="ApiCommonWorkflow::Main::WorkflowSteps::SymLinkDataDirFile">
     <paramValue name="fromFile">$$getPeripheralProteinsDir$$/fastas.tar.gz</paramValue>
     <paramValue name="toFile">$$peripheralDir$$/fastas.tar.gz</paramValue>
     <depends name="copyCoreProteomes"/>
  </step>

  <!-- Combine "did core change" (CheckOrthomclBuildVersion.pm, over in OrthoMCLCore.xml)
       and "did peripheral change" (checkBuildVersionCreatePeripheralOutdatedOrganisms,
       above) into the single-file skip gates the two mutually-exclusive rebuild-mode
       subgraphs below each need. -->
  <step name="checkOrthoFinderRebuildMode" stepClass="ApiCommonWorkflow::Main::WorkflowSteps::CheckOrthoFinderRebuildMode">
    <paramValue name="coreChangedFile">$$coreProteinsDir$$/coreChanged</paramValue>
    <paramValue name="peripheralUnchangedFile">$$getPeripheralProteinsDir$$/doNotDoAnalysis</paramValue>
    <paramValue name="skipFullRebuildFile">$$peripheralDir$$/skipFullRebuild</paramValue>
    <paramValue name="skipIncrementalFile">$$peripheralDir$$/skipIncremental</paramValue>
    <depends name="copyPeripheralProteomes"/>
  </step>

  <!-- Previous run's baseline artifacts for the incremental path, pulled out of the
       shared persistent cache (which lives outside the workflow data dir) into the
       workflow data dir so they travel to the cluster like everything else. Skip-gated
       on skipIncremental (same file makeIncrementalGroups itself uses below): these
       files only need to exist for the incremental path, and on a full rebuild they
       may genuinely be absent (e.g. the very first run, before any incremental-path
       cache entry has ever been populated); running them unconditionally turned a
       full rebuild's success into a hostage of files it never actually reads. -->
  <step name="copyPeripheralFullGroupFileForIncremental" stepClass="ApiCommonWorkflow::Main::WorkflowSteps::CopyPeripheralCacheFile" skipIfFile="$$peripheralDir$$/skipIncremental">
    <paramValue name="fromFile">fullGroupFile.txt</paramValue>
    <paramValue name="toFile">$$peripheralDir$$/fullGroupFile.txt</paramValue>
    <depends name="checkOrthoFinderRebuildMode"/>
  </step>

  <step name="copyPeripheralResidualGroupFileForIncremental" stepClass="ApiCommonWorkflow::Main::WorkflowSteps::CopyPeripheralCacheFile" skipIfFile="$$peripheralDir$$/skipIncremental">
    <paramValue name="fromFile">reformattedGroups.txt</paramValue>
    <paramValue name="toFile">$$peripheralDir$$/residualReformattedGroups.txt</paramValue>
    <depends name="checkOrthoFinderRebuildMode"/>
  </step>

  <step name="copyPeripheralProteinToOrganismForIncremental" stepClass="ApiCommonWorkflow::Main::WorkflowSteps::CopyPeripheralCacheFile" skipIfFile="$$peripheralDir$$/skipIncremental">
    <paramValue name="fromFile">proteinToOrganism.tsv</paramValue>
    <paramValue name="toFile">$$peripheralDir$$/proteinToOrganism.tsv</paramValue>
    <depends name="checkOrthoFinderRebuildMode"/>
  </step>

  <step name="copyPeripheralStableGroupsDatabaseForIncremental" stepClass="ApiCommonWorkflow::Main::WorkflowSteps::CopyPeripheralCacheFile" skipIfFile="$$peripheralDir$$/skipIncremental">
    <paramValue name="fromFile">orthoBUILDVERSIONdb.dmnd</paramValue>
    <paramValue name="toFile">$$peripheralDir$$/stableGroupsDatabase.dmnd</paramValue>
    <depends name="checkOrthoFinderRebuildMode"/>
  </step>

  <step name="copyPeripheralFullProteomeForIncremental" stepClass="ApiCommonWorkflow::Main::WorkflowSteps::CopyPeripheralCacheFile" skipIfFile="$$peripheralDir$$/skipIncremental">
    <paramValue name="fromFile">fullProteome.fasta</paramValue>
    <paramValue name="toFile">$$peripheralDir$$/previousFullProteome.fasta</paramValue>
    <depends name="checkOrthoFinderRebuildMode"/>
  </step>

  <step name="copyPeripheralCoreBestRepsForIncremental" stepClass="ApiCommonWorkflow::Main::WorkflowSteps::CopyPeripheralCacheFile" skipIfFile="$$peripheralDir$$/skipIncremental">
    <paramValue name="fromFile">coreBestReps.txt</paramValue>
    <paramValue name="toFile">$$peripheralDir$$/cachedCoreBestReps.txt</paramValue>
    <depends name="checkOrthoFinderRebuildMode"/>
  </step>

  <step name="copyPeripheralResidualBestRepsForIncremental" stepClass="ApiCommonWorkflow::Main::WorkflowSteps::CopyPeripheralCacheFile" skipIfFile="$$peripheralDir$$/skipIncremental">
    <paramValue name="fromFile">residualBestReps.txt</paramValue>
    <paramValue name="toFile">$$peripheralDir$$/cachedResidualBestReps.txt</paramValue>
    <depends name="checkOrthoFinderRebuildMode"/>
  </step>

  <step name="copyPeripheralCoreStatsForIncremental" stepClass="ApiCommonWorkflow::Main::WorkflowSteps::CopyPeripheralCacheFile" skipIfFile="$$peripheralDir$$/skipIncremental">
    <paramValue name="fromFile">groupStats/core_stats.txt</paramValue>
    <paramValue name="toFile">$$peripheralDir$$/cachedCoreStats.txt</paramValue>
    <depends name="checkOrthoFinderRebuildMode"/>
  </step>

  <step name="copyPeripheralGroupStatsForIncremental" stepClass="ApiCommonWorkflow::Main::WorkflowSteps::CopyPeripheralCacheFile" skipIfFile="$$peripheralDir$$/skipIncremental">
    <paramValue name="fromFile">groupStats/peripheral_stats.txt</paramValue>
    <paramValue name="toFile">$$peripheralDir$$/cachedPeripheralStats.txt</paramValue>
    <depends name="checkOrthoFinderRebuildMode"/>
  </step>

  <step name="copyPeripheralIntraGroupBlastFileForIncremental" stepClass="ApiCommonWorkflow::Main::WorkflowSteps::CopyPeripheralCacheFile" skipIfFile="$$peripheralDir$$/skipIncremental">
    <paramValue name="fromFile">intraGroupBlastFile.tsv</paramValue>
    <paramValue name="toFile">$$peripheralDir$$/cachedIntraGroupBlastFile.tsv</paramValue>
    <depends name="checkOrthoFinderRebuildMode"/>
  </step>

  <step name="copyPeripheralResidualStatsForIncremental" stepClass="ApiCommonWorkflow::Main::WorkflowSteps::CopyPeripheralCacheFile" skipIfFile="$$peripheralDir$$/skipIncremental">
    <paramValue name="fromFile">groupStats/residual_stats.txt</paramValue>
    <paramValue name="toFile">$$peripheralDir$$/cachedResidualStats.txt</paramValue>
    <depends name="checkOrthoFinderRebuildMode"/>
  </step>

  <step name="copyPeripheralIntraResidualGroupBlastFileForIncremental" stepClass="ApiCommonWorkflow::Main::WorkflowSteps::CopyPeripheralCacheFile" skipIfFile="$$peripheralDir$$/skipIncremental">
    <paramValue name="fromFile">intraResidualGroupBlastFile.tsv</paramValue>
    <paramValue name="toFile">$$peripheralDir$$/cachedIntraResidualGroupBlastFile.tsv</paramValue>
    <depends name="checkOrthoFinderRebuildMode"/>
  </step>

  <!-- Filters the full current peripheral proteome set down to just the organisms
       makeIncrementalGroups should actually reprocess (changed per outdated.txt, or
       brand new). Without this, the incremental path was diamond-searching and
       reassigning every peripheral organism every run, not just what changed. Also,
       an unchanged organism whose sequences all successfully reassigned back to
       their existing groups would end up with a 0-sequence leftover fasta, which
       OrthoFinder can't handle (misreads "no amino acids found" as nucleotide data
       and hard-fails). -->
  <step name="makeIncrementalChangedProteomesDir" stepClass="ApiCommonWorkflow::Main::WorkflowSteps::MakeIncrementalChangedProteomesDir" skipIfFile="$$peripheralDir$$/skipIncremental">
    <paramValue name="proteomesDir">$$getPeripheralProteinsDir$$/fastas</paramValue>
    <paramValue name="outdatedFile">$$peripheralDir$$/outdated.txt</paramValue>
    <paramValue name="outputDir">$$peripheralDir$$</paramValue>
    <depends name="checkOrthoFinderRebuildMode"/>
    <depends name="checkBuildVersionCreatePeripheralOutdatedOrganisms"/>
  </step>

  <!-- Full rebuild: core changed (or both changed)  unchanged from before. -->
  <subgraph name="makePeripheralGroups" xmlFile="orthoFinderPeripheral.xml" skipIfFile="$$peripheralDir$$/skipFullRebuild">
    <paramValue name="projectName">$$projectName$$</paramValue>
    <paramValue name="gusConfigFile">$$projectName$$/$$projectName$$_gus.config</paramValue>
    <paramValue name="peripheralDir">$$peripheralDir$$</paramValue>
    <paramValue name="getPeripheralProteinsDir">$$getPeripheralProteinsDir$$</paramValue>
    <depends name="checkOrthoFinderRebuildMode"/>
  </subgraph>

  <!-- Incremental: core unchanged, only peripheral organisms changed
       reassign into existing core/residual groups and cluster only the leftovers. -->
  <subgraph name="makeIncrementalGroups" xmlFile="orthoFinderIncremental.xml" skipIfFile="$$peripheralDir$$/skipIncremental">
    <paramValue name="projectName">$$projectName$$</paramValue>
    <paramValue name="gusConfigFile">$$projectName$$/$$projectName$$_gus.config</paramValue>
    <paramValue name="peripheralDir">$$peripheralDir$$</paramValue>
    <paramValue name="getPeripheralProteinsDir">$$getPeripheralProteinsDir$$</paramValue>
    <depends name="copyPeripheralFullGroupFileForIncremental"/>
    <depends name="copyPeripheralResidualGroupFileForIncremental"/>
    <depends name="copyPeripheralProteinToOrganismForIncremental"/>
    <depends name="copyPeripheralStableGroupsDatabaseForIncremental"/>
    <depends name="copyPeripheralFullProteomeForIncremental"/>
    <depends name="copyPeripheralCoreBestRepsForIncremental"/>
    <depends name="copyPeripheralResidualBestRepsForIncremental"/>
    <depends name="copyPeripheralCoreStatsForIncremental"/>
    <depends name="copyPeripheralGroupStatsForIncremental"/>
    <depends name="copyPeripheralIntraGroupBlastFileForIncremental"/>
    <depends name="copyPeripheralResidualStatsForIncremental"/>
    <depends name="copyPeripheralIntraResidualGroupBlastFileForIncremental"/>
    <depends name="makeIncrementalChangedProteomesDir"/>
  </subgraph>

<!-- Add functionality to get all files from split of results -->
  <step name="copyPeripheralResults" stepClass="ApiCommonWorkflow::Main::WorkflowSteps::CopyPeripheralGroupsResultsFromCache">
    <paramValue name="analysisDir">$$peripheralDir$$/analysisDir/</paramValue>
    <depends name="makePeripheralGroups"/>
    <depends name="makeIncrementalGroups"/>
    <depends name="copyPeripheralProteomes"/>
  </step>

  <step name="copyPeripheralCheckSumToCache" stepClass="ApiCommonWorkflow::Main::WorkflowSteps::CopyPeripheralCheckSumToCache">
    <paramValue name="checkSum">$$getPeripheralProteinsDir$$/fastas/checkSum.tsv</paramValue>
    <depends name="copyPeripheralResults"/>
  </step>

  <step name="loadCoreGroups" stepClass="ApiCommonWorkflow::Main::WorkflowSteps::InsertCoreGroups">
    <paramValue name="groupsFile">$$peripheralDir$$/analysisDir/peripheralEntryResults/GroupsFile.txt</paramValue>
    <paramValue name="gusConfigFile">$$projectName$$/$$projectName$$_gus.config</paramValue>
    <depends name="copyPeripheralCheckSumToCache"/>
  </step>

  <step name="loadResidualGroups" stepClass="ApiCommonWorkflow::Main::WorkflowSteps::InsertResidualGroups">
    <paramValue name="groupsFile">$$peripheralDir$$/analysisDir/postResidualEntryResults/reformattedGroups.txt</paramValue>
    <paramValue name="gusConfigFile">$$projectName$$/$$projectName$$_gus.config</paramValue>
    <depends name="loadCoreGroups"/>
  </step>

  <step name="loadCoreGroupAASequence" stepClass="ApiCommonWorkflow::Main::WorkflowSteps::InsertOrthoGroupAASequence">
      <paramValue name="groupsFile">$$peripheralDir$$/analysisDir/peripheralEntryResults/GroupsFile.txt</paramValue>
      <paramValue name="gusConfigFile">$$projectName$$/$$projectName$$_gus.config</paramValue>
      <depends name="loadResidualGroups"/>
  </step>

  <step name="loadResidualGroupAASequence" stepClass="ApiCommonWorkflow::Main::WorkflowSteps::InsertOrthoGroupAASequence">
      <paramValue name="groupsFile">$$peripheralDir$$/analysisDir/postResidualEntryResults/reformattedGroups.txt</paramValue>
      <paramValue name="gusConfigFile">$$projectName$$/$$projectName$$_gus.config</paramValue>
      <depends name="loadCoreGroupAASequence"/>
  </step>

  <step name="insertOrthogroupCoreStats" stepClass="ApiCommonWorkflow::Main::WorkflowSteps::InsertOrthoGroupStats" stepLoadTypes="plugin">
      <paramValue name="groupStatsFile">$$peripheralDir$$/analysisDir/peripheralEntryResults/groupStats/core_stats.txt</paramValue>
      <paramValue name="proteinSubset">C</paramValue>
      <paramValue name="gusConfigFile">$$projectName$$/$$projectName$$_gus.config</paramValue>
      <depends name="loadResidualGroupAASequence"/>
  </step>

  <step name="insertOrthogroupCorePeripheralStats" stepClass="ApiCommonWorkflow::Main::WorkflowSteps::InsertOrthoGroupStats" stepLoadTypes="plugin">
      <paramValue name="groupStatsFile">$$peripheralDir$$/analysisDir/peripheralEntryResults/groupStats/peripheral_stats.txt</paramValue>
      <paramValue name="proteinSubset">C+P</paramValue>
      <paramValue name="gusConfigFile">$$projectName$$/$$projectName$$_gus.config</paramValue>
      <depends name="insertOrthogroupCoreStats"/>
  </step>

  <step name="insertOrthogroupResidualStats" stepClass="ApiCommonWorkflow::Main::WorkflowSteps::InsertOrthoGroupStats" stepLoadTypes="plugin">
      <paramValue name="groupStatsFile">$$peripheralDir$$/analysisDir/postResidualEntryResults/groupStats/residual_stats.txt</paramValue>
      <paramValue name="proteinSubset">R</paramValue>
      <paramValue name="gusConfigFile">$$projectName$$/$$projectName$$_gus.config</paramValue>
      <depends name="insertOrthogroupCorePeripheralStats"/>
  </step>

  <step name="insertCoreOrthoGroupBlastValues" stepClass="ApiCommonWorkflow::Main::WorkflowSteps::InsertOrthoGroupBlastValues" stepLoadTypes="plugin">
      <paramValue name="groupBlastValuesFile">$$peripheralDir$$/analysisDir/peripheralEntryResults/intraGroupBlastFile.tsv</paramValue>
      <paramValue name="gusConfigFile">$$projectName$$/$$projectName$$_gus.config</paramValue>
      <depends name="insertOrthogroupResidualStats"/>
  </step>

  <step name="insertResidualOrthoGroupBlastValues" stepClass="ApiCommonWorkflow::Main::WorkflowSteps::InsertOrthoGroupBlastValues" stepLoadTypes="plugin">
      <paramValue name="groupBlastValuesFile">$$peripheralDir$$/analysisDir/postResidualEntryResults/intraResidualGroupBlastFile.tsv</paramValue>
      <paramValue name="gusConfigFile">$$projectName$$/$$projectName$$_gus.config</paramValue>
      <depends name="insertCoreOrthoGroupBlastValues"/>
  </step>

  <step name="insertSimilarOrthologgroups" stepClass="ApiCommonWorkflow::Main::WorkflowSteps::InsertSimilarOrthologGroups" stepLoadTypes="plugin">
      <paramValue name="similarGroups">$$peripheralDir$$/analysisDir/postProcessingEntryResults/similar_groups.tsv</paramValue>
      <paramValue name="gusConfigFile">$$projectName$$/$$projectName$$_gus.config</paramValue>
      <depends name="insertResidualOrthoGroupBlastValues"/>
  </step>

  <step name="insertPreviousGroupMapping" stepClass="ApiCommonWorkflow::Main::WorkflowSteps::InsertPreviousGroupMapping" stepLoadTypes="plugin">
      <paramValue name="mappingFile">$$peripheralDir$$/analysisDir/postProcessingEntryResults/previousGroups.txt</paramValue>
      <paramValue name="gusConfigFile">$$projectName$$/$$projectName$$_gus.config</paramValue>
      <depends name="copyPeripheralResults"/>
  </step>

</workflowGraph>
