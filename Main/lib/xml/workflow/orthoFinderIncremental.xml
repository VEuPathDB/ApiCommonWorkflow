<workflowGraph name="OrthoFinderIncremental">
    <param name="projectName"/>
    <param name="gusConfigFile"/>
    <param name="peripheralDir"/>
    <param name="getPeripheralProteinsDir"/>

    <constant name="nextflowWorkflow">VEuPathDB/orthofinder-nextflow</constant>

    <step name="makeOrthoFinderIncrementalNextflowConfig" stepClass="ApiCommonWorkflow::Main::WorkflowSteps::MakeOrthoFinderIncrementalNextflowConfig">
      <paramValue name="workingDirRelativePath">$$peripheralDir$$</paramValue>
      <paramValue name="clusterResultDir">$$peripheralDir$$/analysisDir/incrementalEntryResults/</paramValue>
      <paramValue name="configFileName">incrementalEntryNextflow.config</paramValue>
      <paramValue name="analysisDir">$$peripheralDir$$/analysisDir</paramValue>
      <paramValue name="changedOrNewProteomes">$$peripheralDir$$/fastas.tar.gz</paramValue>
      <!-- Previous run's baseline: cached core+peripheral group membership, cached
           residual group membership, the persisted protein->organism map, and the
           cached full-proteome diamond database, all copied into peripheralDir from
           the shared persistent cache by the CopyPeripheralCacheFile steps in the
           parent graph (orthomclPeripheralWorkflow.xml). -->
      <paramValue name="fullGroupFile">$$peripheralDir$$/fullGroupFile.txt</paramValue>
      <paramValue name="residualGroupFile">$$peripheralDir$$/residualReformattedGroups.txt</paramValue>
      <paramValue name="proteinToOrganism">$$peripheralDir$$/proteinToOrganism.tsv</paramValue>
      <paramValue name="outdatedOrganisms">$$peripheralDir$$/outdated.txt</paramValue>
      <paramValue name="stableGroupsDatabase">$$peripheralDir$$/stableGroupsDatabase.dmnd</paramValue>
      <paramValue name="previousFullProteome">$$peripheralDir$$/previousFullProteome.fasta</paramValue>
      <paramValue name="cachedCoreBestReps">$$peripheralDir$$/cachedCoreBestReps.txt</paramValue>
      <paramValue name="cachedResidualBestReps">$$peripheralDir$$/cachedResidualBestReps.txt</paramValue>
      <paramValue name="cachedCoreStats">$$peripheralDir$$/cachedCoreStats.txt</paramValue>
      <paramValue name="cachedPeripheralStats">$$peripheralDir$$/cachedPeripheralStats.txt</paramValue>
      <paramValue name="cachedIntraGroupBlastFile">$$peripheralDir$$/cachedIntraGroupBlastFile.tsv</paramValue>
      <paramValue name="cachedResidualStats">$$peripheralDir$$/cachedResidualStats.txt</paramValue>
      <paramValue name="cachedIntraResidualGroupBlastFile">$$peripheralDir$$/cachedIntraResidualGroupBlastFile.tsv</paramValue>
      <paramValue name="coreSpeciesIds">$$peripheralDir$$/coreSpeciesIds.txt</paramValue>
    </step>

    <subgraph name="runOrthoIncrementalNextflowOnCluster" xmlFile="runOrthoNextflowOnCluster.xml">
      <paramValue name="gusConfigFile">$$projectName$$/$$projectName$$_gus.config</paramValue>
      <paramValue name="projectName">$$projectName$$</paramValue>
      <paramValue name="parentDataDir">$$peripheralDir$$</paramValue>
      <paramValue name="nextflowConfigFile">$$peripheralDir$$/analysisDir/incrementalEntryNextflow.config</paramValue>
      <paramValue name="resultDirName">incrementalEntryResults</paramValue>
      <paramValue name="ngsSamplesNextflowConfigFile"></paramValue>
      <paramValue name="organismAbbrev"></paramValue> <!-- Not neccessary for ortho -->
      <paramValue name="genomeSpec">$$projectName$$|peripheralGroups</paramValue> <!-- Using for correct naming of preprocessed data cache -->
      <paramValue name="isProteomeAnalysis">true</paramValue>
      <paramValue name="datasetSpec"></paramValue> <!-- Not neccessary for ortho -->
      <paramValue name="analysisDir">$$peripheralDir$$/analysisDir</paramValue>
      <paramValue name="nextflowWorkflow">$$nextflowWorkflow$$</paramValue>
      <paramValue name="entry">incrementalEntry</paramValue>
      <depends name="makeOrthoFinderIncrementalNextflowConfig"/>
    </subgraph>

    <!-- incrementalEntry's own internal call to residualWorkflow (clustering just the
         leftover unassigned sequences, X) publishes the exact same residualFasta.fa /
         Orthogroups.txt / SpeciesIDs.txt / SequenceIDs.txt / blastsFile.txt shape that
         residualEntry alone produces, so postResidualEntry can run unchanged, just
         pointed at incrementalEntryResults/ instead of residualEntryResults/. -->
    <step name="makeOrthoFinderIncrementalPostResidualEntryNextflowConfig" stepClass="ApiCommonWorkflow::Main::WorkflowSteps::MakeOrthoFinderPostResidualEntryNextflowConfig">
      <paramValue name="workingDirRelativePath">$$peripheralDir$$</paramValue>
      <paramValue name="clusterResultDir">$$peripheralDir$$/analysisDir/postResidualEntryResults/</paramValue>
      <paramValue name="configFileName">postResidualEntryNextflow.config</paramValue>
      <paramValue name="analysisDir">$$peripheralDir$$/analysisDir</paramValue>
      <paramValue name="residualFasta">$$peripheralDir$$/analysisDir/incrementalEntryResults/residualFasta.fa</paramValue>
      <paramValue name="groupsFile">$$peripheralDir$$/analysisDir/incrementalEntryResults/Orthogroups.txt</paramValue>
      <paramValue name="speciesMapping">$$peripheralDir$$/analysisDir/incrementalEntryResults/SpeciesIDs.txt</paramValue>
      <paramValue name="sequenceMapping">$$peripheralDir$$/analysisDir/incrementalEntryResults/SequenceIDs.txt</paramValue>
      <paramValue name="diamondResultsFile">$$peripheralDir$$/analysisDir/incrementalEntryResults/blastsFile.txt</paramValue>
      <depends name="runOrthoIncrementalNextflowOnCluster"/>
    </step>

    <subgraph name="runOrthoFinderIncrementalPostResidualEntryNextflowOnCluster" xmlFile="runOrthoNextflowOnCluster.xml">
      <paramValue name="gusConfigFile">$$projectName$$/$$projectName$$_gus.config</paramValue>
      <paramValue name="projectName">$$projectName$$</paramValue>
      <paramValue name="parentDataDir">$$peripheralDir$$</paramValue>
      <paramValue name="nextflowConfigFile">$$peripheralDir$$/analysisDir/postResidualEntryNextflow.config</paramValue>
      <paramValue name="resultDirName">postResidualEntryResults</paramValue>
      <paramValue name="ngsSamplesNextflowConfigFile"></paramValue>
      <paramValue name="organismAbbrev"></paramValue> <!-- Not neccessary for ortho -->
      <paramValue name="genomeSpec">$$projectName$$|peripheralGroups</paramValue> <!-- Using for correct naming of preprocessed data cache -->
      <paramValue name="isProteomeAnalysis">true</paramValue>
      <paramValue name="datasetSpec"></paramValue> <!-- Not neccessary for ortho -->
      <paramValue name="analysisDir">$$peripheralDir$$/analysisDir</paramValue>
      <paramValue name="nextflowWorkflow">$$nextflowWorkflow$$</paramValue>
      <paramValue name="entry">postResidualEntry</paramValue>
      <depends name="makeOrthoFinderIncrementalPostResidualEntryNextflowConfig"/>
    </subgraph>

    <!-- coreAndPeripheralGroups/coreBestRepsFasta/coreAndPeripheralProteome come from
         incrementalEntry's own outputs (updatedStableGroups.txt already contains both
         updated core AND stable residual groups; coreBestReps.fasta/currentFullProteome
         are produced directly by incrementalWorkflow) rather than peripheralEntryResults/,
         since the incremental path never runs peripheralEntry. -->
    <step name="makeOrthoFinderIncrementalPostProcessingEntryNextflowConfig" stepClass="ApiCommonWorkflow::Main::WorkflowSteps::MakeOrthoFinderPostProcessingEntryNextflowConfig">
      <paramValue name="workingDirRelativePath">$$peripheralDir$$</paramValue>
      <paramValue name="clusterResultDir">$$peripheralDir$$/analysisDir/postProcessingEntryResults/</paramValue>
      <paramValue name="configFileName">postProcessingEntryNextflow.config</paramValue>
      <paramValue name="analysisDir">$$peripheralDir$$/analysisDir</paramValue>
      <paramValue name="residualFasta">$$peripheralDir$$/analysisDir/incrementalEntryResults/residualFasta.fa</paramValue>
      <paramValue name="residualBestRepsFasta">$$peripheralDir$$/analysisDir/postResidualEntryResults/bestReps.fasta</paramValue>
      <paramValue name="coreBestRepsFasta">$$peripheralDir$$/analysisDir/incrementalEntryResults/coreBestReps.fasta</paramValue>
      <paramValue name="coreAndPeripheralGroups">$$peripheralDir$$/analysisDir/incrementalEntryResults/updatedStableGroups.txt</paramValue>
      <paramValue name="coreAndPeripheralProteome">$$peripheralDir$$/analysisDir/incrementalEntryResults/fullProteome.fasta</paramValue>
      <paramValue name="coreGroupFastas">$$peripheralDir$$/analysisDir/incrementalEntryResults/touchedGroupFastas</paramValue>
      <paramValue name="residualGroupFastas">$$peripheralDir$$/analysisDir/postResidualEntryResults/residualGroupFastas</paramValue>
      <paramValue name="residualGroups">$$peripheralDir$$/analysisDir/incrementalEntryResults/Orthogroups.txt</paramValue>
      <paramValue name="oldGroupsFile">$$peripheralDir$$/previousGroups.txt</paramValue>
      <paramValue name="bestRepDiamondOutputFields">qseqid sseqid evalue</paramValue>
      <depends name="runOrthoFinderIncrementalPostResidualEntryNextflowOnCluster"/>
    </step>

    <subgraph name="runOrthoFinderIncrementalPostProcessingEntryNextflowOnCluster" xmlFile="runOrthoNextflowOnCluster.xml">
      <paramValue name="gusConfigFile">$$projectName$$/$$projectName$$_gus.config</paramValue>
      <paramValue name="projectName">$$projectName$$</paramValue>
      <paramValue name="parentDataDir">$$peripheralDir$$</paramValue>
      <paramValue name="nextflowConfigFile">$$peripheralDir$$/analysisDir/postProcessingEntryNextflow.config</paramValue>
      <paramValue name="resultDirName">postProcessingEntryResults</paramValue>
      <paramValue name="ngsSamplesNextflowConfigFile"></paramValue>
      <paramValue name="organismAbbrev"></paramValue> <!-- Not neccessary for ortho -->
      <paramValue name="genomeSpec">$$projectName$$|peripheralGroups</paramValue> <!-- Using for correct naming of preprocessed data cache -->
      <paramValue name="isProteomeAnalysis">true</paramValue>
      <paramValue name="datasetSpec"></paramValue> <!-- Not neccessary for ortho -->
      <paramValue name="analysisDir">$$peripheralDir$$/analysisDir</paramValue>
      <paramValue name="nextflowWorkflow">$$nextflowWorkflow$$</paramValue>
      <paramValue name="entry">postProcessingEntry</paramValue>
      <depends name="makeOrthoFinderIncrementalPostProcessingEntryNextflowConfig"/>
    </subgraph>

    <!-- loadCoreGroups/loadCoreGroupAASequence (in the parent graph) expect
         peripheralEntryResults/GroupsFile.txt regardless of which rebuild mode ran;
         the incremental path's equivalent is updatedStableGroups.txt (already contains
         both the updated core AND the stable residual groups). -->
    <step name="copyIncrementalGroupsFileForLoaders" stepClass="ApiCommonWorkflow::Main::WorkflowSteps::CopyDataDirFile">
      <paramValue name="fromFile">$$peripheralDir$$/analysisDir/incrementalEntryResults/updatedStableGroups.txt</paramValue>
      <paramValue name="toFile">$$peripheralDir$$/analysisDir/peripheralEntryResults/GroupsFile.txt</paramValue>
      <depends name="runOrthoIncrementalNextflowOnCluster"/>
    </step>

    <!-- insertOrthogroupCoreStats/insertOrthogroupCorePeripheralStats/insertCoreOrthoGroupBlastValues
         (in the parent graph) expect these files under peripheralEntryResults/ regardless of which
         rebuild mode ran; incrementalWorkflow already produces the merged (cached-untouched-groups +
         freshly-recomputed-touched-groups) versions under incrementalEntryResults/. -->
    <step name="makePeripheralEntryResultsGroupStatsDir" stepClass="ReFlow::StepClasses::MakeDataDir">
      <paramValue name="dataDir">$$peripheralDir$$/analysisDir/peripheralEntryResults/groupStats</paramValue>
      <depends name="runOrthoIncrementalNextflowOnCluster"/>
    </step>

    <step name="copyIncrementalCoreStatsForLoaders" stepClass="ApiCommonWorkflow::Main::WorkflowSteps::CopyDataDirFile">
      <paramValue name="fromFile">$$peripheralDir$$/analysisDir/incrementalEntryResults/groupStats/core_stats.txt</paramValue>
      <paramValue name="toFile">$$peripheralDir$$/analysisDir/peripheralEntryResults/groupStats/core_stats.txt</paramValue>
      <depends name="makePeripheralEntryResultsGroupStatsDir"/>
    </step>

    <step name="copyIncrementalPeripheralStatsForLoaders" stepClass="ApiCommonWorkflow::Main::WorkflowSteps::CopyDataDirFile">
      <paramValue name="fromFile">$$peripheralDir$$/analysisDir/incrementalEntryResults/groupStats/peripheral_stats.txt</paramValue>
      <paramValue name="toFile">$$peripheralDir$$/analysisDir/peripheralEntryResults/groupStats/peripheral_stats.txt</paramValue>
      <depends name="makePeripheralEntryResultsGroupStatsDir"/>
    </step>

    <step name="copyIncrementalIntraGroupBlastFileForLoaders" stepClass="ApiCommonWorkflow::Main::WorkflowSteps::CopyDataDirFile">
      <paramValue name="fromFile">$$peripheralDir$$/analysisDir/incrementalEntryResults/intraGroupBlastFile.tsv</paramValue>
      <paramValue name="toFile">$$peripheralDir$$/analysisDir/peripheralEntryResults/intraGroupBlastFile.tsv</paramValue>
      <depends name="runOrthoIncrementalNextflowOnCluster"/>
    </step>

    <!-- insertOrthogroupResidualStats/insertResidualOrthoGroupBlastValues (in the parent
         graph) unconditionally read postResidualEntryResults/groupStats/residual_stats.txt
         and postResidualEntryResults/intraResidualGroupBlastFile.tsv. The chained
         postResidualEntry run above only clusters the leftover unassigned (X) sequences,
         so its own residual_stats.txt/intraResidualGroupBlastFile.tsv cover only
         brand-new residual groups; they know nothing about a pre-existing residual
         group that simply gained a member this run. incrementalWorkflow already computed
         that piece (cached-untouched-groups + freshly-recomputed-touched-groups) as
         mergedResidualStats.txt/mergedIntraResidualGroupBlastFile.tsv; combine the two
         and overwrite postResidualEntryResults' copy so the loaders see the complete set. -->
    <step name="concatenateIncrementalResidualStats" stepClass="ApiCommonWorkflow::Main::WorkflowSteps::ConcatenateTwoFiles">
      <paramValue name="inputFile1">$$peripheralDir$$/analysisDir/incrementalEntryResults/mergedResidualStats.txt</paramValue>
      <paramValue name="inputFile2">$$peripheralDir$$/analysisDir/postResidualEntryResults/groupStats/residual_stats.txt</paramValue>
      <paramValue name="outputFile">$$peripheralDir$$/analysisDir/postResidualEntryResults/groupStats/residual_stats_combined.txt</paramValue>
      <depends name="runOrthoFinderIncrementalPostResidualEntryNextflowOnCluster"/>
    </step>

    <step name="copyIncrementalResidualStatsForLoaders" stepClass="ApiCommonWorkflow::Main::WorkflowSteps::CopyDataDirFile">
      <paramValue name="fromFile">$$peripheralDir$$/analysisDir/postResidualEntryResults/groupStats/residual_stats_combined.txt</paramValue>
      <paramValue name="toFile">$$peripheralDir$$/analysisDir/postResidualEntryResults/groupStats/residual_stats.txt</paramValue>
      <depends name="concatenateIncrementalResidualStats"/>
    </step>

    <step name="concatenateIncrementalIntraResidualGroupBlastFile" stepClass="ApiCommonWorkflow::Main::WorkflowSteps::ConcatenateTwoFiles">
      <paramValue name="inputFile1">$$peripheralDir$$/analysisDir/incrementalEntryResults/mergedIntraResidualGroupBlastFile.tsv</paramValue>
      <paramValue name="inputFile2">$$peripheralDir$$/analysisDir/postResidualEntryResults/intraResidualGroupBlastFile.tsv</paramValue>
      <paramValue name="outputFile">$$peripheralDir$$/analysisDir/postResidualEntryResults/intraResidualGroupBlastFile_combined.tsv</paramValue>
      <depends name="runOrthoFinderIncrementalPostResidualEntryNextflowOnCluster"/>
    </step>

    <step name="copyIncrementalIntraResidualGroupBlastFileForLoaders" stepClass="ApiCommonWorkflow::Main::WorkflowSteps::CopyDataDirFile">
      <paramValue name="fromFile">$$peripheralDir$$/analysisDir/postResidualEntryResults/intraResidualGroupBlastFile_combined.tsv</paramValue>
      <paramValue name="toFile">$$peripheralDir$$/analysisDir/postResidualEntryResults/intraResidualGroupBlastFile.tsv</paramValue>
      <depends name="concatenateIncrementalIntraResidualGroupBlastFile"/>
    </step>

</workflowGraph>
