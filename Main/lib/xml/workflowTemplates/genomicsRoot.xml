<workflowGraph name="multipleProjects">
  <param name="projectName"/> <!-- GenomicsDB -->

  <constant name="globalDatasetLoaderXmlFile">GenomicsGlobal.xml</constant>
  <constant name="multiProjectsDataDir">multiProjects</constant>


  <!-- call globalGraph (Mustafa's but we added back things like NRDB ...-->
  <globalSubgraph name="global" xmlFile="globalGraph.xml">
    <paramValue name="commonDatasetLoaderXmlFile">$$projectName$$/$$projectName$$Common.xml</paramValue>
    <paramValue name="globalDatasetLoaderXmlFile">$$globalDatasetLoaderXmlFile$$</paramValue>
    <paramValue name="projectName">$$projectName$$</paramValue>
  </globalSubgraph>

  <step name="makeMultiProjectsDataDir" stepClass="ReFlow::StepClasses::MakeDataDir">
    <paramValue name="dataDir">$$multiProjectsDataDir$$</paramValue>
  </step>

  <step name="initClusterHomeDir"
        stepClass="ReFlow::StepClasses::InitClusterHomeDir">
    <!--    <depends name="initUserGroupProject"/>-->
  </step>

  <!-- call project.xml (generated) for each component -->

  <datasetTemplate class="genomicsProject">
    <prop name="projectName"/>
    <prop name="areBigGenomes"/>

    <subgraph name="${projectName}" xmlFile="generated/${projectName}/project.xml">
      <paramValue name="projectName">${projectName}</paramValue>
      <paramValue name="projectVersionForWebsiteFiles">CURRENT</paramValue>
      <paramValue name="areBigGenomes">${areBigGenomes}</paramValue>
      <depends name="initClusterHomeDir"/>
    </subgraph>
  </datasetTemplate>


  <subgraph name="sampleDetailsForEda" xmlFile="sampleDetailsForEda.xml">
    <paramValue name="gusConfigFile">$$projectName$$_gus.config</paramValue>
    <paramValue name="parentDataDir">$$multiProjectsDataDir$$</paramValue>
    <depends name="PlasmoDB"/>
    <depends name="ToxoDB"/>
    <depends name="TriTrypDB"/>
    <depends name="VectorBase"/>
    <depends name="AmoebaDB"/>
    <depends name="CryptoDB"/>
    <depends name="FungiDB"/>
    <depends name="PiroplasmaDB"/>
    <depends name="GiardiaDB"/>
    <depends name="MicrosporidiaDB"/>
    <depends name="TrichDB"/>
    <depends name="HostDB"/>
    <depends name="HelminthDB"/>
    <depends name="makeMultiProjectsDataDir"/>
  </subgraph>

  
  <datasetTemplate class="orthomclGenomics">
    <!-- ATTENTION:  This graph has dependsExternals by PROJECT.  If you add a project above, you must also add it here -->
    <subgraph name="OrthoMCL" xmlFile="orthomclGenomics.xml">
      <paramValue name="projectName">OrthoMCL</paramValue>
      <paramValue name="projectVersionForWebsiteFiles">CURRENT</paramValue>
      <depends name="initClusterHomeDir"/>
    </subgraph>

    <subgraph name="OrthoMCLDependent" xmlFile="OrthoMCLDependent.xml">
      <paramValue name="projectName">OrthoMCL</paramValue>
      <paramValue name="gusConfigFile">OrthoMCL/OrthoMCL_gus.config</paramValue>
      <paramValue name="parentDataDir">$$multiProjectsDataDir$$</paramValue>
      <paramValue name="orthomclPeripheralResultsDir">OrthoMCL/peripheralGroups/analysisDir/postProcessingEntryResults/</paramValue>
      <depends name="PlasmoDB"/>
      <depends name="ToxoDB"/>
      <depends name="TriTrypDB"/>
      <depends name="VectorBase"/>
      <depends name="AmoebaDB"/>
      <depends name="CryptoDB"/>
      <depends name="FungiDB"/>
      <depends name="PiroplasmaDB"/>
      <depends name="GiardiaDB"/>
      <depends name="MicrosporidiaDB"/>
      <depends name="TrichDB"/>
      <depends name="HostDB"/>
      <depends name="HelminthDB"/>
      <depends name="OrthoMCL"/>
      <depends name="makeMultiProjectsDataDir"/>
      <dependsGlobal name="enzymeDB_RSRC"/>
    </subgraph>

  </datasetTemplate>
  
  <subgraph name="alphaFold" xmlFile="loadDataset.xml">
    <paramValue name="datasetName">alphaFold_RSRC</paramValue>
    <paramValue name="datasetLoaderXmlFileName">GenomicsDB.xml</paramValue>
    <paramValue name="parentDataDir">$$multiProjectsDataDir$$</paramValue>
    <paramValue name="gusConfigFile">$$projectName$$_gus.config</paramValue>
    <depends name="makeMultiProjectsDataDir"/>
    <depends name="PlasmoDB"/>
    <depends name="ToxoDB"/>
    <depends name="TriTrypDB"/>
    <depends name="VectorBase"/>
    <depends name="AmoebaDB"/>
    <depends name="CryptoDB"/>
    <depends name="FungiDB"/>
    <depends name="PiroplasmaDB"/>
    <depends name="GiardiaDB"/>
    <depends name="MicrosporidiaDB"/>
    <depends name="TrichDB"/>
    <depends name="HostDB"/>
    <depends name="HelminthDB"/>
  </subgraph>

  <subgraph name="ExternalResourceUrl" xmlFile="loadDataset.xml">
    <paramValue name="datasetName">ExternalResourceUrl_Ensembl_RSRC</paramValue>
    <paramValue name="datasetLoaderXmlFileName">GenomicsDB.xml</paramValue>
    <paramValue name="parentDataDir">$$multiProjectsDataDir$$</paramValue>
    <paramValue name="gusConfigFile">$$projectName$$_gus.config</paramValue>
    <depends name="makeMultiProjectsDataDir"/>
    <depends name="PlasmoDB"/>
    <depends name="ToxoDB"/>
    <depends name="TriTrypDB"/>
    <depends name="VectorBase"/>
    <depends name="AmoebaDB"/>
    <depends name="CryptoDB"/>
    <depends name="FungiDB"/>
    <depends name="PiroplasmaDB"/>
    <depends name="GiardiaDB"/>
    <depends name="MicrosporidiaDB"/>
    <depends name="TrichDB"/>
    <depends name="HostDB"/>
    <depends name="HelminthDB"/>
  </subgraph>


  <subgraph name="MakeComparativeWebTables" xmlFile="comparativeWebreadyTables.xml">
    <paramValue name="gusConfigFile">$$projectName$$_gus.config</paramValue>
    <paramValue name="projectName">$$projectName$$</paramValue>
    <depends name="OrthoMCLDependent"/>
    <depends name="alphaFold"/>
  </subgraph>

  <!-- the partitioned parent tables are never analyzed by the per organism steps;
       do it once all organism webready tables exist so clones inherit the stats -->
  <step name="analyzeWebreadyPartitionedTables" stepClass="ApiCommonWorkflow::Main::WorkflowSteps::AnalyzeWebreadyPartitionedTables">
    <paramValue name="gusConfigFile">$$projectName$$_gus.config</paramValue>
    <depends name="PlasmoDB"/>
    <depends name="ToxoDB"/>
    <depends name="TriTrypDB"/>
    <depends name="VectorBase"/>
    <depends name="AmoebaDB"/>
    <depends name="CryptoDB"/>
    <depends name="FungiDB"/>
    <depends name="PiroplasmaDB"/>
    <depends name="GiardiaDB"/>
    <depends name="MicrosporidiaDB"/>
    <depends name="TrichDB"/>
    <depends name="HostDB"/>
    <depends name="HelminthDB"/>
  </step>

  <!-- apidb.fileattributes (download file records).  The loads run last, once all
       data the download files come from (ESTs included) is in the DB. -->

  <datasetTemplate class="fileAttributesHistory">
    <prop name="historyFile"/>

    <step name="fileAttributesHistory_makeDataDir" stepClass="ReFlow::StepClasses::MakeDataDir">
      <paramValue name="dataDir">$$multiProjectsDataDir$$/fileAttributesHistory_RSRC</paramValue>
      <depends name="makeMultiProjectsDataDir"/>
    </step>

    <!-- manualGet: copies manualDelivery common/downloadData/${historyFile} into the data dir -->
    <step name="fileAttributesHistory_getAndUnpack" stepClass="ApiCommonWorkflow::Main::WorkflowSteps::DatasetLoaderGetAndUnpack">
      <paramValue name="gusConfigFile">$$projectName$$_gus.config</paramValue>
      <paramValue name="datasetName">fileAttributesHistory_RSRC</paramValue>
      <paramValue name="datasetLoaderXmlFileName">GenomicsDB.xml</paramValue>
      <paramValue name="dataDir">$$multiProjectsDataDir$$/fileAttributesHistory_RSRC</paramValue>
      <depends name="fileAttributesHistory_makeDataDir"/>
    </step>

    <step name="fileAttributesHistory_load" stepClass="ApiCommonWorkflow::Main::WorkflowSteps::LoadFileAttributes">
      <paramValue name="gusConfigFile">$$projectName$$_gus.config</paramValue>
      <paramValue name="inputFile">$$multiProjectsDataDir$$/fileAttributesHistory_RSRC/${historyFile}</paramValue>
      <depends name="fileAttributesHistory_getAndUnpack"/>
      <depends name="analyzeWebreadyPartitionedTables"/>
      <depends name="MakeComparativeWebTables"/>
      <depends name="sampleDetailsForEda"/>
      <depends name="ExternalResourceUrl"/>
    </step>
  </datasetTemplate>

  <!-- the extract reads this workflow's staging downloadSite, so it runs after
       every graph that writes download files -->
  <datasetTemplate class="fileAttributesRelease">
    <prop name="release"/>

    <step name="fileAttributesRelease_${release}_makeDataDir" stepClass="ReFlow::StepClasses::MakeDataDir">
      <paramValue name="dataDir">$$multiProjectsDataDir$$/fileAttributesRelease_${release}</paramValue>
      <depends name="makeMultiProjectsDataDir"/>
    </step>

    <step name="fileAttributesRelease_${release}_extract" stepClass="ApiCommonWorkflow::Main::WorkflowSteps::ExtractFileAttributes">
      <paramValue name="gusConfigFile">$$projectName$$_gus.config</paramValue>
      <paramValue name="release">${release}</paramValue>
      <paramValue name="outputFile">$$multiProjectsDataDir$$/fileAttributesRelease_${release}/bld${release}.tab</paramValue>
      <depends name="fileAttributesRelease_${release}_makeDataDir"/>
      <depends name="analyzeWebreadyPartitionedTables"/>
      <depends name="MakeComparativeWebTables"/>
      <depends name="sampleDetailsForEda"/>
      <depends name="ExternalResourceUrl"/>
    </step>

    <step name="fileAttributesRelease_${release}_load" stepClass="ApiCommonWorkflow::Main::WorkflowSteps::LoadFileAttributes">
      <paramValue name="gusConfigFile">$$projectName$$_gus.config</paramValue>
      <paramValue name="inputFile">$$multiProjectsDataDir$$/fileAttributesRelease_${release}/bld${release}.tab</paramValue>
      <depends name="fileAttributesRelease_${release}_extract"/>
    </step>
  </datasetTemplate>

</workflowGraph>
